\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Outline of this survey.} A top-down view of the paper structure. The root problem is robust RAG under unreliable evidence; the survey then moves from background and taxonomy to evidence-centric, model-centric, adversarial, system-control, evaluation, synthesis, and future-facing guidelines. Each leaf lists representative cited work using compact aliases.}}{19}{figure.caption.22}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:survey_outline}{{1}{19}{\textbf {Outline of this survey.} A top-down view of the paper structure. The root problem is robust RAG under unreliable evidence; the survey then moves from background and taxonomy to evidence-centric, model-centric, adversarial, system-control, evaluation, synthesis, and future-facing guidelines. Each leaf lists representative cited work using compact aliases}{figure.caption.22}{}}
