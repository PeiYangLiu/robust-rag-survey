manuscript/supplement/api_pack_runs/
manuscript/supplement/screen_recall_runs/
manuscript/supplement/abstention_verdict_runs/

# ---- De-identified export the README marks as omitted from releases ----
manuscript/supplement/v3_human_reanalysis_20260725/

# ---- Scratch and root-level LaTeX build junk ----
/tmp/
/main.aux
/main.log
/main.fls
/main.fdb_latexmk
/w.out
manuscript/figures/texput.log

