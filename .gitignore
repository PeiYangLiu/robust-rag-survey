# ============================================================
#  robust-rag-survey — backup .gitignore
#  Excludes multi-GB third-party PDF corpora, regenerable
#  text extractions, archives, and LaTeX/Python build junk.
#  Authored content (.tex/.bib/.csv/.json/.md, scripts,
#  human_coding data, figures, final PDFs) is kept.
# ============================================================

# ---- Large downloaded paper PDF corpora (third-party, not authored) ----
/pdfs/
manuscript/citation_audit/pdfs/
manuscript/citation_audit/expanded_pdfs/
exemplar/*.pdf

# ---- Regenerable plain text extracted from PDFs ----
manuscript/citation_audit/texts/
manuscript/citation_audit/expanded_texts/
metadata/venue_200_texts/
metadata/multimodal_rag_100_texts/
metadata/venue_extra_texts/

# ---- Archives (regenerable packages) ----
*.zip

# ---- LaTeX build artifacts (manuscript/) ----
manuscript/*.aux
manuscript/*.log
manuscript/*.fls
manuscript/*.fdb_latexmk
manuscript/*.out
manuscript/*.blg
manuscript/*.bbl
manuscript/*.synctex.gz
manuscript/*.toc
manuscript/*.lof
manuscript/*.lot
manuscript/*.bcf
manuscript/*.run.xml

# ---- Access-controlled human-study records (never release) ----
manuscript/human_coding/heldout_claim_validation_v3_20260715/participant_metadata_private.csv
manuscript/human_coding/heldout_claim_validation_v3_20260715/private_records/
manuscript/human_coding/heldout_claim_validation_v3_20260715/README.md
/files/*
!/files/v3_invalidated_shared_answer_run_20260719/
/files/v3_invalidated_shared_answer_run_20260719/*
!/files/v3_invalidated_shared_answer_run_20260719/invalidation_report.json

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- Local Amulet project state ----
.amltconfig
configs/amlt_controlled_model_judges.yaml

# ---- Python virtualenvs (never release) ----
.venv*/
/files/

# ---- Third-party public corpora re-downloaded for sigma_r anchors ----
# (civil_comments, wikipedia detox, MultiPref, DynaSent: fetch from source)
manuscript/supplement/sigma_anchors/

# ---- Raw per-decision model-judge dumps (regenerable; analysis-level
